12:["$","section",null,{"className":"section feature","id":"mira","aria-labelledby":"mira-title","children":[["$","div",null,{"className":"margin","children":[["$","h2",null,{"id":"mira-title","children":"02 / Case study"}],["$","p",null,{"children":"Sephora · Summer 2026"}]]}],["$","article",null,{"className":"prose","children":[["$","div",null,{"className":"project-heading","children":[["$","h3",null,{"children":"MiRA"}],["$","span",null,{"className":"eyebrow","children":"Voice · Vision · Reasoning"}]]}],["$","p",null,{"className":"expansion","children":"Multimodal Intelligence and Reasoning Architecture"}],["$","p",null,{"className":"lede","children":"From speech-model evaluation to a production multimodal service layer."}],["$","div",null,{"className":"case-scope","children":[["$","span",null,{"className":"eyebrow","children":"Scope of ownership"}],["$","p",null,{"children":"System architecture, model integration, retrieval, deployment, and production troubleshooting."}]]}],["$","div",null,{"className":"case-chapters","children":[["$","section","The mandate",{"children":[["$","h4",null,{"children":"The mandate"}],["$","p",null,{"children":"I joined Sephora’s AI Beauty Chat team in summer 2026 with a focused brief: evaluate speech-to-text models. The product serves 10+ million users, and the team had won the Grand Prize in the LVMH Business of Tomorrow Cup. I expanded that initial exploration into MiRA, a service layer that brings voice interaction, visual search, and spoken review highlights to the same product experience."}]]}],["$","section","The system",{"children":[["$","h4",null,{"children":"The system"}],["$","p",null,{"children":"I built real-time voice infrastructure over WebSockets, integrating gpt-4o-transcribe, gpt-4o-mini-tts, and streaming speech recognition through a realtime model gateway. LangGraph and LiteLLM supported orchestration and model routing. For visual retrieval, I fine-tuned CLIP with LoRA and indexed more than 12,000 products in PostgreSQL with pgvector, grounding image-based search in the product catalog."}]]}],["$","section","Production ownership",{"children":[["$","h4",null,{"children":"Production ownership"}],["$","p",null,{"children":"I carried the system through Azure and Kubernetes deployment, with stateless microservices, KEDA autoscaling, CI/CD through GitHub Actions and Opsera, and a feedback loop for model improvement. Operational work included diagnosing autoscaling, gateway, and model-routing failures. I also presented MiRA four times: an internal showcase for 100+ people, a dedicated review with an SVP, VP, and Senior Directors, an internal tech sync, and the intern program’s closing showcase."}]]}]]}],["$","aside",null,{"className":"outcome","children":[["$","span",null,{"className":"eyebrow","children":"Outcome"}],["$","p",null,{"children":"Return offer to rejoin Sephora as a GenAI Scientist in January 2027."}]]}]]}]]}]
13:["$","section",null,{"className":"section","id":"projects","aria-labelledby":"projects-title","children":[["$","div",null,{"className":"margin","children":["$","h2",null,{"id":"projects-title","children":"03 / Other work"}]}],["$","div",null,{"children":[["$","article","Content automation platform",{"className":"project","children":[["$","div",null,{"className":"project-top","children":[["$","h3",null,{"children":"Content automation platform"}],["$","span",null,{"className":"eyebrow","children":"Wordcorn AI"}]]}],["$","p",null,{"children":"A system for content generation, scheduling, and multi-channel publishing. Python pipelines coordinated API integrations and long-running workflows, with duplicate prevention and end-to-end validation."}]]}],["$","article","Sephora Summer Game",{"className":"project","children":[["$","div",null,{"className":"project-top","children":[["$","h3",null,{"children":"Sephora Summer Game"}],["$","span",null,{"className":"eyebrow","children":"A playable memory"}]]}],["$","p",null,{"children":"An animated retelling of my internship, built over a weekend with Codex. Every point collected represents a real milestone from the summer. A small game about a very full few months."}]]}],["$","article","Published Android apps",{"className":"project","children":[["$","div",null,{"className":"project-top","children":[["$","h3",null,{"children":"Published Android apps"}],["$","span",null,{"className":"eyebrow","children":"Independent development"}]]}],["$","p",null,{"children":"Multiple apps published on the Play Store, beginning after that eighth-grade workshop. My first experience of taking an idea all the way to something another person could actually use."}]]}]]}]]}]
14:["$","section",null,{"className":"section","id":"about","aria-labelledby":"about-title","children":[["$","div",null,{"className":"margin","children":["$","h2",null,{"id":"about-title","children":"04 / About"}]}],["$","div",null,{"className":"prose","children":[["$","p","I’m a generative AI engineer pursuing an M.S. in Computer Science at California State University, Long Beach, with a concentration in machine learning. I graduate in December 2026.",{"children":"I’m a generative AI engineer pursuing an M.S. in Computer Science at California State University, Long Beach, with a concentration in machine learning. I graduate in December 2026."}],["$","p","I grew up in India and started building software after an app development workshop in eighth grade. Publishing multiple Android apps on the Play Store gave me an early grounding in taking an idea from implementation to real users.",{"children":"I grew up in India and started building software after an app development workshop in eighth grade. Publishing multiple Android apps on the Play Store gave me an early grounding in taking an idea from implementation to real users."}],["$","p","I moved to the US on my own for graduate school. I’m funding it myself, without financial support from family, and have worked throughout my degree. It’s been an education in more than computer science.",{"children":"I moved to the US on my own for graduate school. I’m funding it myself, without financial support from family, and have worked throughout my degree. It’s been an education in more than computer science."}]]}]]}]
15:["$","section",null,{"className":"section","id":"reflection","aria-labelledby":"reflection-title","children":[["$","div",null,{"className":"margin","children":["$","h2",null,{"id":"reflection-title","children":"05 / Perspective"}]}],["$","div",null,{"className":"prose","children":[["$","h3",null,{"className":"note-title","children":"A model is one part of the system."}],[["$","p","Building MiRA made the relationship between model quality and system quality concrete. A useful model still depends on retrieval, latency, deployment, failure handling, and feedback. Owning the complete path changed how I evaluate an AI system: by the experience it can sustain in production.",{"children":"Building MiRA made the relationship between model quality and system quality concrete. A useful model still depends on retrieval, latency, deployment, failure handling, and feedback. Owning the complete path changed how I evaluate an AI system: by the experience it can sustain in production."}],["$","p","Working through graduate school far from family has shaped that approach. I value consistent execution, clear communication, and taking responsibility for the details. I also want to keep showing up for the people in my life while doing work I’m proud of.",{"children":"Working through graduate school far from family has shaped that approach. I value consistent execution, clear communication, and taking responsibility for the details. I also want to keep showing up for the people in my life while doing work I’m proud of."}]]]}]]}]
16:["$","section",null,{"className":"section now","id":"now","aria-labelledby":"now-title","children":[["$","div",null,{"className":"margin","children":[["$","h2",null,{"id":"now-title","children":"06 / Now"}],["$","p",null,{"children":"September 2026"}]]}],["$","div",null,{"className":"prose","children":["$","p",null,{"children":"Finishing my M.S. in December 2026. Returning to Sephora as a GenAI Scientist in January 2027. Always building something on the side."}]}]]}]
